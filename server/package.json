{
  "name": "minja-cloud-server",
  "version": "1.0.0",
  "description": "Minja Cloud VPS Backend API — Central Fleet, Owner, Partner, Operator, and Delivery Services",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "simulate": "tsx scripts/kiosk-simulator.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "vitest run --fileParallelism=false"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.7",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.33.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/sharp": "^0.32.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
