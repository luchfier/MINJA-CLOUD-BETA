# ==============================================================================
# MINJA CLOUD VPS PLATFORM — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. DATABASE UTAMA (PostgreSQL / Supabase)
# Opsi Standar / Local / Supabase Direct Connection (Port 5432):
DATABASE_URL="postgresql://postgres:password@localhost:5432/minjacloud_db?schema=public"

# Jika menggunakan Supabase Connection Pooling (Transaction Mode Port 6543 untuk aplikasi cepat):
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# 2. KEAMANAN & AUTENTIKASI (JWT)
# Buat string acak minimal 32 karakter (contoh: openssl rand -base64 32)
JWT_SECRET="ganti_dengan_jwt_secret_rahasia_anda_minimal_32_karakter_random"
CLOUD_MASTER_KEY="minja_cloud_master_secret_key_change_me"
BOOTH_API_KEY="mja_kiosk_live_master_sync_key"

# 3. PAYMENT GATEWAY (Midtrans Core API — Opsional jika diproses via Cloud)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# 4. OBJECT STORAGE (Cloudflare R2 / AWS S3 — Galeri Publik 48 Jam)
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY="your_r2_access_key_id"
S3_SECRET_KEY="your_r2_secret_access_key"
S3_BUCKET_NAME="minjaphotobooth"
S3_REGION="auto"
R2_PUBLIC_DOMAIN="https://pub-<hash>.r2.dev"

# 5. DOMAIN PUBLIK GALERI PELANGGAN
GALLERY_BASE_URL="https://gallery.minja.com"

# 6. EMAIL DELIVERY SERVICE (Pilih salah satu: Resend API atau SMTP)
# Opsi A: Resend API (HTTPS REST Port 443 — Sangat direkomendasikan untuk VPS)
RESEND_API_KEY=""
RESEND_FROM="Minja Photobooth <onboarding@resend.dev>"

# Opsi B: SMTP / Nodemailer (Gmail / Mailgun / Amazon SES)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Minja Photobooth <noreply@minjaphotobooth.com>"

# 7. SERVER RUNTIME & LOGGING
NODE_ENV="development"
PORT="3000"
LOG_LEVEL="info"
