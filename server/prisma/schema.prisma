// prisma/schema.prisma
// MinjaPhotobooth — Database Schema
// Sesuai DATABASE_SCHEMA.md v2.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// 1. Admin — Satu admin per instalasi (singleton)
// ============================================================
model Admin {
  id              String   @id @default(cuid())
  pinHash         String   @map("pin_hash")     // Argon2id hash
  failedAttempts  Int      @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  auditLogs       AuditLog[]

  @@map("admins")
}

// ============================================================
// 2. Settings — Konfigurasi global booth (singleton)
// ============================================================
model Settings {
  id                       String   @id @default(cuid())
  
  // Branding (publik)
  boothName                String   @default("MinjaPhotobooth") @map("booth_name")
  brandTitle               String   @default("Minja Photobooth") @map("brand_title")
  welcomeText              String   @default("Selamat datang!") @map("welcome_text")
  primaryColor             String   @default("#6C5CE7") @map("primary_color")
  secondaryColor           String   @default("#A29BFE") @map("secondary_color")
  logoUrl                  String?  @map("logo_url")
  wallpaperUrl             String?  @map("wallpaper_url")
  attractVideoUrl          String?  @map("attract_video_url")
  
  // Kontak & Promosi Studio (Web Promosi)
  whatsappNumber           String?  @default("6281234567890") @map("whatsapp_number")
  instagramHandle          String?  @default("@minjastudio") @map("instagram_handle")
  studioAddress            String?  @default("Lokasi Booth Minja Studio") @map("studio_address")
  promoHeadline            String?  @default("Abadikan Momen Terbaik dengan Kualitas Studio Lab") @map("promo_headline")
  promoSubheadline         String?  @default("Nikmati pengalaman berfoto mandiri tanpa canggung. Cetak foto fisik studio tahan air dalam hitungan detik, pilihan frame strip eksklusif, plus unduhan digital langsung ke smartphone Anda.") @map("promo_subheadline")
  eventPackages            Json?    @map("event_packages")
  
  // Page Builder Engine Configs (Landing Page & Mobile Gallery)
  pageBuilderLanding       Json?    @map("page_builder_landing")
  pageBuilderGallery       Json?    @map("page_builder_gallery")
  customCss                String?  @map("custom_css")
  
  // Operasional
  retentionHours           Int      @default(48) @map("retention_hours")
  maxSessionTimeoutSeconds Int      @default(600) @map("max_session_timeout_seconds")
  paymentTimeoutSeconds    Int      @default(300) @map("payment_timeout_seconds")
  autoResetSeconds         Int      @default(30) @map("auto_reset_seconds")
  maintenanceMode          Boolean  @default(false) @map("maintenance_mode")
  
  // Feature flags
  emailDeliveryEnabled     Boolean  @default(true) @map("email_delivery_enabled")
  galleryEnabled           Boolean  @default(true) @map("gallery_enabled")
  livePhotoEnabled         Boolean  @default(true) @map("live_photo_enabled")
  
  // Hardware references
  selectedCameraId         String?  @map("selected_camera_id")
  selectedPrinterName      String?  @map("selected_printer_name")
  
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ============================================================
// 3. Package — Paket sesi pelanggan
// ============================================================
model Package {
  id                   String   @id @default(cuid())
  name                 String
  badge                String?
  description          String   @default("")
  price                Int      // Rupiah (contoh: 35000)
  durationSeconds      Int      @map("duration_seconds")
  maxShots             Int      @map("max_shots")
  maxSelections        Int      @map("max_selections")
  defaultPrints        Int      @map("default_prints")
  additionalPrintPrice Int      @default(0) @map("additional_print_price")
  sortOrder            Int      @default(0) @map("sort_order")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sessions             Session[]
  accessCodes          AccessCode[]

  partnerId            String?  @map("partner_id")
  partner              Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@map("packages")
}

// ============================================================
// 4. Template — Template foto cetak studio
// ============================================================
model Template {
  id              String   @id @default(cuid())
  name            String
  thumbnailUrl    String   @map("thumbnail_url")
  frameOverlayUrl String   @map("frame_overlay_url")
  orientation     String   @default("portrait") // "portrait" | "landscape"
  slotsCount      Int      @map("slots_count")
  slots           Json     // Array<{index, x, y, width, height, rotation}>
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions        Session[]

  @@map("templates")
}

// ============================================================
// 5. Session — Sesi pelanggan
// ============================================================
model Session {
  id                   String       @id @default(cuid())
  packageId            String       @map("package_id")
  templateId           String?      @map("template_id")
  state                SessionState @default(AWAITING_PAYMENT)
  
  // Harga (dikalkulasi oleh backend saat sesi dibuat)
  basePrice            Int          @map("base_price")
  additionalPrints     Int          @default(0) @map("additional_prints")
  additionalPrintCost  Int          @default(0) @map("additional_print_cost")
  totalPrice           Int          @map("total_price")
  
  // Batas (disalin dari paket saat sesi dibuat)
  maxShots             Int          @map("max_shots")
  maxSelections        Int          @map("max_selections")
  totalPrints          Int          @map("total_prints")
  durationSeconds      Int          @map("duration_seconds")
  
  // Statistik aktual
  shotsTaken           Int          @default(0) @map("shots_taken")
  photosSelected       Int          @default(0) @map("photos_selected")
  photosPrinted        Int          @default(0) @map("photos_printed")
  
  // Timestamps
  cancelReason         String?      @map("cancel_reason")
  expiresAt            DateTime     @map("expires_at")
  completedAt          DateTime?    @map("completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  package              Package      @relation(fields: [packageId], references: [id])
  template             Template?    @relation(fields: [templateId], references: [id])
  kioskId              String?      @map("kiosk_id")
  kiosk                Kiosk?       @relation(fields: [kioskId], references: [id])
  payments             Payment[]
  photos               Photo[]
  gallery              Gallery?
  printJobs            PrintJob[]
  deliveryJobs         DeliveryJob[]
  accessCode           AccessCode?

  @@index([state])
  @@index([createdAt])
  @@index([kioskId])
  @@map("sessions")
}

enum SessionState {
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  CAPTURE_ACTIVE
  PHOTO_REVIEW
  PHOTO_EDITING
  RENDERING
  PRINTING
  SHARING
  COMPLETED
  CANCELLED
  EXPIRED
}

// ============================================================
// 6. Payment — Transaksi pembayaran Midtrans
// ============================================================
model Payment {
  id                 String        @id @default(cuid())
  sessionId          String        @map("session_id")
  orderId            String        @unique @map("order_id")   // MINJA-YYYYMMDD-SEQ
  grossAmount        Int           @map("gross_amount")
  paymentType        String        @default("qris") @map("payment_type")
  transactionStatus  PaymentStatus @default(pending) @map("transaction_status")
  qrString           String?       @map("qr_string")   // EMVCo QRIS string
  qrImageUrl         String?       @map("qr_image_url")
  midtransId         String?       @map("midtrans_id")  // transaction_id dari Midtrans
  isVerified         Boolean       @default(false) @map("is_verified")
  
  expiryTime         DateTime      @map("expiry_time")
  settlementTime     DateTime?     @map("settlement_time")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Relations
  session            Session       @relation(fields: [sessionId], references: [id])
  webhookEvents      WebhookEvent[]

  @@index([orderId])
  @@index([transactionStatus])
  @@map("payments")
}

enum PaymentStatus {
  pending
  settlement
  expire
  cancel
  deny
  refund
}

// ============================================================
// 7. Photo — Metadata foto per sesi
// ============================================================
model Photo {
  id              String   @id @default(cuid())
  sessionId       String   @map("session_id")
  shotNumber      Int      @map("shot_number")
  localFilePath   String   @map("local_file_path")
  originalFilename String  @map("original_filename")
  fileSizeBytes   Int      @map("file_size_bytes")
  width           Int
  height          Int
  mimeType        String   @map("mime_type")        // "image/jpeg" | "image/png"
  storageKey      String?  @map("storage_key")      // Key di object storage
  storageUrl      String?  @map("storage_url")      // Public/signed URL
  isSelected      Boolean  @default(false) @map("is_selected")
  createdAt       DateTime @default(now()) @map("created_at")

  session         Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, shotNumber])
  @@index([sessionId])
  @@map("photos")
}

// ============================================================
// 8. CameraConfig — Konfigurasi kamera tersedia
// ============================================================
model CameraConfig {
  id          String   @id @default(cuid())
  deviceId    String   @unique @map("device_id")
  name        String
  type        String   // "webcam" | "virtual_webcam" | "canon_dslr"
  isActive    Boolean  @default(true) @map("is_active")
  settings    Json?    // Pengaturan khusus per kamera (resolusi, exposure, dll.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("camera_configs")
}

// ============================================================
// 9. PrinterConfig — Konfigurasi printer tersedia
// ============================================================
model PrinterConfig {
  id             String   @id @default(cuid())
  printerName    String   @unique @map("printer_name")
  displayName    String   @map("display_name")
  paperSize      String   @default("Standard") @map("paper_size")
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  settings       Json?    // Pengaturan khusus (margin, borderless, orientasi)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("printer_configs")
}

// ============================================================
// 10. PrintJob — Antrean cetak
// ============================================================
model PrintJob {
  id              String         @id @default(cuid())
  sessionId       String         @map("session_id")
  imageFilePath   String         @map("image_file_path")
  printerName     String         @map("printer_name")
  copies          Int            @default(1)
  status          PrintJobStatus @default(queued)
  errorMessage    String?        @map("error_message")
  isReprint       Boolean        @default(false) @map("is_reprint")
  reprintReason   String?        @map("reprint_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  session         Session        @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([status])
  @@map("print_jobs")
}

enum PrintJobStatus {
  queued
  printing
  completed
  failed
}

// ============================================================
// 11. Gallery — Galeri privat pelanggan
// ============================================================
model Gallery {
  id           String        @id @default(cuid())
  sessionId    String        @unique @map("session_id")
  token        String        @unique   // nanoid 32 chars (crypto-secure)
  expiresAt    DateTime      @map("expires_at")
  accessCount  Int           @default(0) @map("access_count")
  createdAt    DateTime      @default(now()) @map("created_at")

  session      Session       @relation(fields: [sessionId], references: [id])
  deliveryJobs DeliveryJob[]

  @@index([token])
  @@index([expiresAt])
  @@map("galleries")
}

// ============================================================
// 12. DeliveryJob — Antrean pengiriman digital
// ============================================================
model DeliveryJob {
  id           String             @id @default(cuid())
  sessionId    String             @map("session_id")
  galleryId    String?            @map("gallery_id")
  channel      DeliveryChannel    @default(email)
  email        String?            @map("email")
  status       DeliveryJobStatus  @default(queued)
  messageId    String?            @map("message_id")     // ID dari Email Service (SMTP)
  retryCount   Int                @default(0) @map("retry_count")
  maxRetries   Int                @default(3) @map("max_retries")
  errorMessage String?            @map("error_message")
  nextRetryAt  DateTime?          @map("next_retry_at")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  session      Session            @relation(fields: [sessionId], references: [id])
  gallery      Gallery?           @relation(fields: [galleryId], references: [id])

  @@index([status])
  @@index([sessionId])
  @@map("delivery_jobs")
}

enum DeliveryChannel {
  email
  qr_gallery
}

enum DeliveryJobStatus {
  queued
  sending
  sent
  delivered
  failed
}

// ============================================================
// 13. WebhookEvent — Catatan webhook Midtrans masuk
// ============================================================
model WebhookEvent {
  id                String   @id @default(cuid())
  paymentId         String   @map("payment_id")
  orderId           String   @map("order_id")
  transactionStatus String   @map("transaction_status")
  statusCode        String   @map("status_code")
  signatureValid    Boolean  @map("signature_valid")
  rawPayload        Json     @map("raw_payload")
  processedAt       DateTime @default(now()) @map("processed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  payment           Payment  @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("webhook_events")
}

// ============================================================
// 14. AuditLog — Catatan tindakan admin
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  action     String   // "ADMIN_LOGIN", "SETTINGS_UPDATED", "PACKAGE_CREATED", dll.
  details    Json?    // Detail perubahan (before/after values)
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin      Admin?   @relation(fields: [adminId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// 15. Voucher — Kode diskon promo pelanggan
// ============================================================
model Voucher {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String?   // Nama promo (contoh: "Promo Weekend Mall A")
  discountType  String    @default("percentage") @map("discount_type") // "percentage" | "fixed"
  discountValue Int       @map("discount_value")
  minSpend      Int       @default(0) @map("min_spend")
  maxDiscount   Int?      @map("max_discount")
  validFrom     DateTime  @default(now()) @map("valid_from")
  validUntil    DateTime  @map("valid_until")
  usageLimit    Int       @default(100) @map("usage_limit")
  usedCount     Int       @default(0) @map("used_count")
  isActive      Boolean   @default(true) @map("is_active")
  
  partnerId     String?   @map("partner_id")
  partner       Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kioskId       String?   @map("kiosk_id")
  kiosk         Kiosk?    @relation(fields: [kioskId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([partnerId])
  @@index([kioskId])
  @@map("vouchers")
}

// ============================================================
// 16. AccessCode — Token sesi bayar tunai (kasir / remote owner)
// ============================================================
model AccessCode {
  id             String           @id @default(cuid())
  code           String           @unique
  packageId      String?          @map("package_id")
  amount         Int              @default(0)
  type           String           @default("SESSION") // "SESSION" | "EXTRA_PRINT"
  extraPrints    Int              @default(0) @map("extra_prints")
  status         AccessCodeStatus @default(ACTIVE)
  customerNote   String?          @map("customer_note")
  cashierName    String?          @default("Owner Remote") @map("cashier_name")
  expiresAt      DateTime         @map("expires_at")
  usedAt         DateTime?        @map("used_at")
  usedSessionId  String?          @unique @map("used_session_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  package        Package?         @relation(fields: [packageId], references: [id])
  session        Session?         @relation(fields: [usedSessionId], references: [id])
  kioskId        String?          @map("kiosk_id")
  kiosk          Kiosk?           @relation(fields: [kioskId], references: [id])
  operatorId     String?          @map("operator_id")
  operator       Operator?        @relation(fields: [operatorId], references: [id])
  partnerId      String?          @map("partner_id")
  partner        Partner?         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([status])
  @@index([expiresAt])
  @@index([kioskId])
  @@index([operatorId])
  @@index([partnerId])
  @@map("access_codes")
}

enum AccessCodeStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

// ============================================================
// 17. Kiosk — Multi-Kiosk Fleet Appliance Registration
// ============================================================
model Kiosk {
  id                String       @id @default(cuid())
  code              String       @unique // contoh: "MJA-01", "MJA-PIM2"
  name              String       // contoh: "Minja Booth 01 - Pondok Indah Mall"
  location          String       // contoh: "Lantai 2 Depan Cinema XXI"
  apiKey            String       @unique @map("api_key") // "mja_kiosk_live_xxx"
  status            KioskStatus  @default(OFFLINE)
  paperRemaining    Int          @default(400) @map("paper_remaining")
  paperRollCapacity Int          @default(400) @map("paper_roll_capacity")
  printerStatus     String?      @map("printer_status")
  cameraStatus      String?      @map("camera_status")
  isLocked          Boolean      @default(false) @map("is_locked")
  lockReason        String?      @map("lock_reason")
  disabledPackageIds Json?       @map("disabled_package_ids") // Array<string> paket dinonaktifkan di booth ini
  lastHeartbeat     DateTime?    @map("last_heartbeat")
  ipAddress         String?      @map("ip_address")
  appVersion        String?      @map("app_version")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  partnerId         String?      @map("partner_id")
  partner           Partner?     @relation(fields: [partnerId], references: [id])

  sessions          Session[]
  accessCodes       AccessCode[]
  operators         Operator[]
  vouchers          Voucher[]

  @@index([code])
  @@index([apiKey])
  @@index([status])
  @@index([partnerId])
  @@map("kiosks")
}

enum KioskStatus {
  ONLINE
  OFFLINE
  IN_SESSION
  PRINTING
  MAINTENANCE
}

// ============================================================
// 18. Partner — Mitra Franchise / Pemilik Lokasi Kiosk
// ============================================================
model Partner {
  id              String      @id @default(cuid())
  name            String      // contoh: "PT Berkah Jaya / Mitra Mall A"
  email           String      @unique
  passwordHash    String      @map("password_hash")
  rawPassword     String?     @map("raw_password") // Password plain tersimpan untuk inspeksi Super Admin via Eye toggle
  phone           String?
  revenueSharePct Int         @default(70) @map("revenue_share_pct") // Persentase bagi hasil mitra (0-100%)
  receiptHeader   String?     @map("receipt_header") // Kustom header cetak struk kasir
  receiptFooter   String?     @map("receipt_footer") // Kustom footer pesan cetak struk kasir
  receiptAddress  String?     @map("receipt_address") // Alamat lokasi fisik cabang
  receiptSocial   String?     @map("receipt_social") // Handle Instagram/TikTok/Medsos
  receiptPolicy   String?     @map("receipt_policy") // Ketentuan S&K / kebijakan penukaran cetak
  receiptPaperWidth Int?      @default(58) @map("receipt_paper_width") // Lebar kertas struk (58 mm / 80 mm)
  receiptConfig   Json?       @map("receipt_config") // Pengaturan visibilitas elemen struk
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  kiosks          Kiosk[]
  operators       Operator[]
  vouchers        Voucher[]
  packages        Package[]
  accessCodes     AccessCode[]

  @@index([email])
  @@index([isActive])
  @@map("partners")
}

// ============================================================
// 19. Operator — Staf Kasir Lapangan Booth
// ============================================================
model Operator {
  id          String       @id @default(cuid())
  partnerId   String       @map("partner_id")
  kioskId     String?      @map("kiosk_id")
  name        String       // contoh: "Budi Kasir Shift Pagi"
  username    String       @unique // username login kasir
  pinHash     String       @map("pin_hash") // PIN kasir
  isActive    Boolean      @default(true) @map("is_active")
  lastLoginAt DateTime?    @map("last_login_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kiosk       Kiosk?       @relation(fields: [kioskId], references: [id])
  accessCodes AccessCode[]

  @@index([username])
  @@index([partnerId])
  @@index([kioskId])
  @@map("operators")
}



